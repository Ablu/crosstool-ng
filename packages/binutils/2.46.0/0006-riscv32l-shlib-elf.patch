Index: binutils-2.46.0/ld/emulparams/elf32lriscv-defs.sh
===================================================================
--- binutils-2.46.0.orig/ld/emulparams/elf32lriscv-defs.sh
+++ binutils-2.46.0/ld/emulparams/elf32lriscv-defs.sh
@@ -16,15 +16,9 @@ if test `echo "$host" | sed -e s/64//` =
   esac
 fi
 
-# Enable shared library support for everything except an embedded elf target.
-case "$target" in
-  riscv*-elf)
-    ;;
-  *)
-    GENERATE_SHLIB_SCRIPT=yes
-    GENERATE_PIE_SCRIPT=yes
-    ;;
-esac
+# Enabling shared library support even for an embedded elf target!
+GENERATE_SHLIB_SCRIPT=yes
+GENERATE_PIE_SCRIPT=yes
 
 IREL_IN_PLT=
 TEXT_START_ADDR=0x10000
